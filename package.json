{
  "name": "aigency",
  "version": "0.1.0",
  "private": true,
  "description": "Aigency — multi-agent AI operating system",
  "scripts": {
    "autofix": "./scripts/automation/autofix.sh fix",
    "autofix:check": "./scripts/automation/autofix.sh check",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules",
    "commit": "cz",
    "commit:ai": "./scripts/automation/generate-commit-msg.sh",
    "coverage:check": "./scripts/automation/coverage-check.sh",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --write",
    "membrane": "turbo run dev --filter=@aigency/membrane",
    "oracle": "turbo run dev --filter=@aigency/oracle",
    "prepare": "lefthook install",
    "review": "./scripts/automation/coderabbit-review.sh quick",
    "review:agent": "./scripts/automation/coderabbit-review.sh agent",
    "review:committed": "./scripts/automation/coderabbit-review.sh committed",
    "review:staged": "./scripts/automation/coderabbit-review.sh staged",
    "router": "turbo run dev --filter=@aigency/router",
    "slice": "./scripts/automation/agent-slice-commit.sh",
    "slice:fast": "./scripts/automation/agent-slice-commit.sh --no-verify",
    "slice:gt": "./scripts/automation/agent-slice-commit.sh --graphite",
    "slice:gt:push": "./scripts/automation/agent-slice-commit.sh --graphite --push",
    "slice:push": "./scripts/automation/agent-slice-commit.sh --push",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "wiki:check": "./scripts/automation/wiki-check.sh",
    "wiki:ingest": "echo 'Run: tell the LLM to ingest a new source into packages/mem-brain/llm-wiki/raw/'",
    "wiki:lint": "echo 'Run: tell the LLM to lint packages/mem-brain/llm-wiki/'",
    "wiki:update": "./scripts/automation/wiki-check.sh --auto-fix"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^22.10.2",
    "commitizen": "^4.3.1",
    "cz-git": "^1.11.1",
    "lefthook": "^1.11.12",
    "lint-staged": "^15.5.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.9.7",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
