{
  "name": "@aigency/commit-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Commit orchestrator for human-agent collaboration",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "bin": {
    "aigency-commit": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsup && echo '#!/usr/bin/env node' | cat - dist/cli.mjs > dist/cli.tmp.mjs && mv dist/cli.tmp.mjs dist/cli.mjs && chmod +x dist/cli.mjs",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "biome check src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "chalk": "^5.4.1",
    "commander": "^13.0.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@aigency/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
