# Galaxy Orchestrator Configuration

# Hermes (VPS)
HERMES_BASE_URL=http://galaxy-oracle:8080
HERMES_API_KEY=

# OMP (MacBook)
OMP_SSH_HOST=macbook-pro
OMP_SSH_USER=
OMP_SSH_KEY_PATH=
OMP_SSH_PORT=22
OMP_COMMAND=omp --mode rpc

# Ventures
GALAXY_VENTURES_DIR=~/galaxy/ventures

# Task defaults
GALAXY_DEFAULT_SKILLS=gstack,paul,carl
GALAXY_TASK_TIMEOUT=600000
GALAXY_BUDGET_LIMIT=
GALAXY_DEFAULT_MODEL=
