{
  "name": "simplellmrouter",
  "version": "1.0.0",
  "description": "Intelligent LLM router for OpenClaw - payment-free ClawRouter alternative",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "simplellmrouter": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "jest --coverage",
    "coordination:check": "tsx scripts/coordination/check.ts",
    "coordination:status": "cat .planning/coordination/state.json",
    "coordination:events": "cat .planning/coordination/events.jsonl"
  },
  "keywords": [
    "llm",
    "router",
    "openclaw",
    "ai",
    "load-balancer"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@types/yaml": "^1.9.7",
    "jest": "^30.2.0",
    "jest-fetch-mock": "^3.0.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "pino": "^10.3.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  }
}
