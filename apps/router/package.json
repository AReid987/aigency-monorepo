{
  "name": "@aigency/router",
  "version": "0.2.0",
  "private": true,
  "description": "Aigency LLM Router — OpenAI-compatible proxy with quota-aware routing, local SLM support, and agent-identity context",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts src/cli.ts --format esm --dts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aigency/agent-core": "workspace:*",
    "zod": "^3.23.8",
    "js-yaml": "^4.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@aigency/tsconfig": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.14",
    "rimraf": "^6.0.1"
  }
}
