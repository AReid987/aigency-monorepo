{
  "name": "@aigency/vault-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Vault compilation, linting, and flush utilities for Aigency Mem_Brain",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "vault-compile": "./dist/bin/compile.js",
    "vault-lint":    "./dist/bin/lint.js",
    "vault-flush":   "./dist/bin/flush.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/compile.ts src/bin/lint.ts src/bin/flush.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@aigency/tsconfig": "workspace:*",
    "@aigency/agent-core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1",
    "@types/node": "^22.10.2"
  }
}
