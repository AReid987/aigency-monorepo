{
  "name": "@aigency/vault-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Vault compilation, linting, and flush utilities for Aigency Mem_Brain",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "vault-compile": "./dist/bin/compile.js",
    "vault-flush": "./dist/bin/flush.js",
    "vault-lint": "./dist/bin/lint.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/compile.ts src/bin/lint.ts src/bin/flush.ts --format esm,cjs --dts",
    "clean": "rimraf dist",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@aigency/agent-core": "workspace:*",
    "@aigency/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
